# cp .env.local.example .env.local
#
# Pull from terraform output (development env):
#   cd infrastructure/environments/development
#   terraform output -raw cognito_user_pool_id
#   terraform output -raw cognito_user_pool_client_id
#   terraform output -raw cognito_hosted_login_url | sed 's|^https://||'
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Hostname only (no protocol), e.g. wallet-note-development-XXXXXXXXXXXX.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Optional. When set, vite dev proxy forwards /api/* to this URL instead of
# the local Go server. Useful for frontend-only iteration against the deployed
# dev API (no local Go required). From terraform output:
#   terraform output -raw web_client_url
# API_PROXY_TARGET=
